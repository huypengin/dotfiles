{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/kinosakimei.png",
    "width": 24,
    "padding": {
      "top": 1,
      "left": 3
    },
  },
  "display": {
    "color": {
      "keys": "#ffffff"
    },
    "key": {
      "width": 14
    },
    "separator": "  "
  },
  "modules": [
    {
      "color": {
        "at": "#666666",
        "host": "#ff8a8a",
        "user": "#ff8a8a"
      },
      "type": "title"
    },
    "break",
    {
      "format": "{pretty-name}",
      "key": "  OS",
      "keyColor": "#71b7ff",
      "type": "os"
    },
    {
      "key": "  Kernel",
      "keyColor": "#d2a8ff",
      "type": "kernel"
    },
    {
      "format": "{pretty-name}",
      "key": "  WM",
      "keyColor": "#ff8a8a",
      "type": "wm"
    },
    {
      "format": "{pretty-name}",
      "key": "  Shell",
      "keyColor": "#8ddb8c",
      "type": "shell"
    },
    {
      "key": " 󰔚 Uptime",
      "keyColor": "#d2b45f",
      "type": "uptime"
    },
    {
      "format": "{used} / {total}",
      "key": "  Ram",
      "keyColor": "#71b7ff",
      "type": "memory"
    },
    {
      "format": "{used} / {total}",
      "key": " 󰓡 Swap",
      "keyColor": "#d2a8ff",
      "type": "swap"
    },
    {
      "format": "{1} / {2}",
      "key": " 󰉉 Disk ",
      "keyColor": "#666666",
      "type": "disk",
      "folders": "/"
    },
    {
      "format": "{pretty-name}",
      "key": " 󰸱 Color",
      "symbol": "circle",
      "type": "colors"
    }
  ]
}
